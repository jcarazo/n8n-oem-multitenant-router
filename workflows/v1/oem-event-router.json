    {
      "parameters": {
        "jsCode": "const tenantId = $input.first().json.body.tenant_id;\nconst eventType = $input.first().json.body.event_type;\nconst payload = $input.first().json.body.payload;\n\nconst configs = {\n  tenant_a: {\n    tenant_id: \"tenant_a\",\n    name: \"E-commerce SMB\",\n    error_mode: \"continue\",\n    data_handling: \"standard\",\n    email: {\n      enabled: true,\n      from_name: \"TenantA Store\",\n      templates: {\n        cart_abandoned: \"tmpl_001\",\n        new_order: \"tmpl_002\",\n        refund_requested: \"tmpl_003\"\n      }\n    },\n    sheet_log: {\n      enabled: true,\n      sheet_id: \"sheet_tenant_a\"\n    },\n    slack: {\n      enabled: false\n    },\n    crm: {\n      enabled: false\n    },\n    audit: {\n      enabled: false\n    }\n  },\n  tenant_b: {\n    tenant_id: \"tenant_b\",\n    name: \"B2B SaaS\",\n    error_mode: \"block\",\n    data_handling: \"standard\",\n    email: {\n      enabled: true,\n      from_name: \"TenantB\",\n      templates: {\n        trial_signup: \"tmpl_010\",\n        upgrade: \"tmpl_011\",\n        churn_signal: \"tmpl_012\"\n      }\n    },\n    sheet_log: {\n      enabled: false\n    },\n    slack: {\n      enabled: true,\n      channel: \"#new-trials\"\n    },\n    crm: {\n      enabled: true,\n      record_type: \"Lead\"\n    },\n    audit: {\n      enabled: false\n    }\n  },\n  tenant_c: {\n    tenant_id: \"tenant_c\",\n    name: \"Healthcare Provider\",\n    error_mode: \"block\",\n    data_handling: \"pii_masked\",\n    email: {\n      enabled: true,\n      from_name: \"HealthcareCo\",\n      templates: {\n        appointment_reminder: \"tmpl_020\",\n        intake_completed: \"tmpl_021\"\n      }\n    },\n    sheet_log: {\n      enabled: false\n    },\n    slack: {\n      enabled: false\n    },\n    crm: {\n      enabled: false\n    },\n    audit: {\n      enabled: true\n    }\n  }\n};\n\nconst config = configs[tenantId];\n\nif (!config) {\n  throw new Error(`Unknown tenant_id: ${tenantId}`);\n}\n\nreturn [{\n  json: {\n    tenant_config: config,\n    event_type: eventType,\n    payload: payload\n  }\n}];"
      },
