    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst payload = { ...data.payload };\n\n// Fields considered PII\nconst piiFields = [\"customer_email\", \"patient_name\", \"dob\", \"phone\", \"address\"];\n\nfor (const field of piiFields) {\n  if (payload[field]) {\n    payload[field] = \"***MASKED***\";\n  }\n}\n\nreturn [{\n  json: {\n    ...data,\n    payload: payload,\n    pii_masked: true\n  }\n}];"
      },
